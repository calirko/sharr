# Public URL clients use for LiveKit signaling (same host as the app; NPM routes /rtc to LiveKit)
LIVEKIT_URL=wss://sharr.calirko.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# Discord OAuth2 (optional; guests work without it)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Server
REDIS_URL=redis://db:6379
PORT=3000
SESSION_SECRET=change-me
