# Public URL clients use for LiveKit signaling (same host as the app; NPM routes /rtc to LiveKit)
# Local dev: ws://localhost:7880
LIVEKIT_URL=wss://sharr.calirko.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
# Internal LiveKit server API. Compose overrides this to http://sharr-livekit:7880 for the app container.
LIVEKIT_API_URL=http://localhost:7880

# Discord OAuth2, identify scope only (optional; guests work without it). Add the redirect URI in the Discord app settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Server
# Compose overrides this to redis://db:6379 for the app container.
REDIS_URL=redis://localhost:6379
PORT=3000
SESSION_SECRET=change-me
# Empty rooms close after this many minutes
ROOM_IDLE_MINUTES=30
